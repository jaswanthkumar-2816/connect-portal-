# ============================================================
# HIERO Interview API
# ============================================================

PORT=4010

# ── Groq ────────────────────────────────────────────────────
# Writes the questions from the job post and reads the answers back into a
# report. Get a key at https://console.groq.com/keys
#
# Without it the service still runs: interviews use a standard question set
# and no assessment is produced. That is for working on the flow, not for
# using on real candidates.
GROQ_API_KEY=

# llama-3.3-70b-versatile is the general-purpose production model. Groq's
# catalogue moves — if a call comes back saying the model is unknown, check
# https://console.groq.com/docs/models; openai/gpt-oss-120b is the usual
# replacement. Both prompts ask for JSON and fall back when they do not get
# it, so swapping the model is low risk.
GROQ_MODEL=llama-3.3-70b-versatile

# ── Security ────────────────────────────────────────────────
# Signs the invite tokens, which are the candidate's whole credential.
# Any long random string. Change it and every outstanding link stops working.
#   openssl rand -hex 32
INTERVIEW_SECRET=

# The gateway that issues recruiter sign-in tokens. Recruiter-facing routes
# are authorised by checking the recruiter's own token against this, so it
# must point at the same gateway the portal signs in to.
HIERO_GATEWAY_URL=http://localhost:2816

# For server-to-server callers only — scripts, cron, another service. It is
# what `npm run link` uses.
#
# NEVER put this value in a VITE_ variable. Everything prefixed VITE_ is
# compiled into the portal's JavaScript bundle, which every candidate
# downloads to take their interview, and these routes mint interviews and
# return other people's assessments.
CONNECT_API_KEY=

# ── Where the portal is ─────────────────────────────────────
# The candidate's link is built on this.
PORTAL_URL=http://localhost:2004

# Browsers allowed to call this API. Comma separated; * allows any.
ALLOWED_ORIGINS=http://localhost:2004,http://localhost:4173

# ── The interviewer's voice ─────────────────────────────────
# Kokoro-82M, downloaded once and run here, so it costs nothing per question.
# The first start fetches roughly 90MB.
#
# VOICE_ENABLED=false falls back to whatever voice the candidate's own
# browser has, which on a cheap Android is a flat robot.
VOICE_ENABLED=true
VOICE_MODEL=onnx-community/Kokoro-82M-v1.0-ONNX
# Graded best to worst: af_heart, af_bella, af_nicole, bf_emma (British),
# am_michael (male). See interview-api/src/voice.js
VOICE_NAME=af_heart
VOICE_DTYPE=q8
VOICE_SPEED=0.95

# ── Interview shape ─────────────────────────────────────────
INVITE_TTL_DAYS=7
QUESTION_COUNT=8

# ── Where interviews in progress are kept ───────────────────
# The same MongoDB the gateway uses — copy MONGODB_URI from the gateway's
# .env. It is not optional in production: without it, sessions go to
# data/sessions.json, and a host with an ephemeral disk (Render's free plan
# throws the disk away and restarts after fifteen idle minutes) loses every
# interview in progress. The candidate sees "that answer could not be saved"
# with no way forward.
MONGODB_URI=

# Only if the database is not the one named in the URI.
MONGODB_DB=

# ── Which voice, and whose machine makes it ─────────────────
# groq  — asked over HTTPS, nothing runs here. The right choice on a small
#         instance: Kokoro's inference is synchronous, so a tenth of a CPU
#         spends a minute inside one request and the host's health check
#         times out and restarts the service mid-interview.
# local — Kokoro-82M in this process. Free per question, needs a real CPU.
# Defaults to groq when GROQ_API_KEY is set.
TTS_PROVIDER=groq
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=tara
