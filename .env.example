# HIERO Connect-Portal Environment Variables

# HIERO Student / Companies Gateway.
# Optional. Left unset, the portal picks by where it is served from:
# http://localhost:2816 on a dev server, https://hiero.in anywhere else.
# Set it only to point a build somewhere other than those two.
VITE_HIERO_GATEWAY_URL=

# HIERO Bridge / Academia Portal (Default: http://localhost:2410)
VITE_BRIDGE_URL=http://localhost:2410

# HIERO Central Python Backend URL (Default: http://localhost:5050)
VITE_PYTHON_BACKEND_URL=http://localhost:5050

# Optional shared-store API key (do not commit a real value)
# Sent as Authorization: Bearer and x-api-key on publish + status calls
VITE_CONNECT_API_KEY=


# Render a sample practice record on the candidate card (design/screenshots only).
# HIERO stores interview sessions but has no recruiter-facing route yet.
VITE_DEMO_PRACTICE=false
