# HIERO Connect-Portal Environment Variables

# HIERO Student / Companies Gateway.
# Optional. Left unset, the portal picks by where it is served from:
# http://localhost:2816 on a dev server, https://hiero.in anywhere else.
# Set it only to point a build somewhere other than those two.
VITE_HIERO_GATEWAY_URL=

# HIERO Bridge / Academia Portal (Default: http://localhost:2410)
VITE_BRIDGE_URL=http://localhost:2410

# HIERO Central Python Backend URL (Default: http://localhost:5050)
VITE_PYTHON_BACKEND_URL=http://localhost:5050

# Optional shared-store API key (do not commit a real value)
# Sent as Authorization: Bearer and x-api-key on publish + status calls
# LEAVE THIS EMPTY IN ANY DEPLOYED BUILD.
#
# Everything prefixed VITE_ is compiled into the JavaScript bundle, and every
# candidate downloads that bundle to take their interview. This key is the
# interview service's trusted-caller key: it mints interviews and reads
# assessments, and it is not scoped to one company. Setting it here hands all
# of that to anyone who opens the page.
#
# A signed-in recruiter does not need it — their own token identifies them and
# the company they may read. It exists for local work against a service with
# no gateway to check tokens against.
VITE_CONNECT_API_KEY=


# Render a sample practice record on the candidate card (design/screenshots only).
# HIERO stores interview sessions but has no recruiter-facing route yet.
VITE_DEMO_PRACTICE=false

# The AI interview is run by the portal itself, at /interview/:token, using
# the token HIERO signs. Set this to false to send candidates to HIERO's own
# interview page instead and leave the invite URL exactly as the gateway
# returned it.
VITE_CONNECT_INTERVIEW=true

# Let the interview fall back to local rehearsal questions when the gateway
# cannot be reached, so the flow can be walked through or demoed offline. On a
# dev server this is on regardless; the page says plainly that it is a
# rehearsal and sends nothing.
VITE_DEMO_INTERVIEW=false
