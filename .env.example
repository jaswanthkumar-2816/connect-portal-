# HIERO Connect-Portal Environment Variables

# HIERO Ecosystem Gateway URL (Default: http://localhost:2816)
# On Vercel deployment (https://connect-portal-swart.vercel.app), set this to your deployed Gateway or ngrok URL
VITE_HIERO_GATEWAY_URL=http://localhost:2816

# HIERO Central Python Backend URL (Default: http://localhost:5050)
VITE_PYTHON_BACKEND_URL=http://localhost:5050

